# ==========================================
# Be[X] v2 — Environment Variables
# ==========================================
# Copy this file to .env.local and fill in values

# --- Auth (required) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Database (required) ---
DATABASE_URL=

# --- Email (required in production: sign-up confirmation, booking emails) ---
RESEND_API_KEY=
EMAIL_FROM=BeNetwork <onboarding@resend.dev>

# --- Map (required for map tiles) ---
NEXT_PUBLIC_MAPTILER_KEY=

# --- AI Agent (required for chat) ---
ANTHROPIC_API_KEY=

# --- AI Fallback + Translation (optional) ---
GOOGLE_GEMINI_API_KEY=
DEEPL_API_KEY=

# --- Admins and domains ---
# Comma-separated emails that become ADMIN on sign-in (review and publish listings)
ADMIN_EMAILS=
# Hosts that show the 4xor company page at "/" (the map stays at /map)
COMPANY_HOSTS=4xor.com,www.4xor.com

# --- Country deployment ---
NEXT_PUBLIC_COUNTRY_CODE=KE
